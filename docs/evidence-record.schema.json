{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-project-governance:evidence-record:1",
  "title": "Portable evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "task_id",
    "classification",
    "subject",
    "provenance",
    "execution",
    "review",
    "delivery_commit",
    "acceptance_satisfied"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": { "type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$" },
    "task_id": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["simulado", "estimado", "executado", "validado"] },
    "subject": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref", "collected_at", "coverage", "age_at_validation", "transformations", "limitations"],
      "properties": {
        "source_kind": { "enum": ["fixture", "repository", "external-system", "human-observation", "calculation"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "collected_at": { "type": "string", "format": "date-time" },
        "coverage": { "type": "string", "minLength": 1 },
        "age_at_validation": { "type": "string", "minLength": 1 },
        "transformations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "execution": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment", "command_or_case", "result", "commit", "reproducible"],
          "properties": {
            "environment": { "type": "string", "minLength": 1 },
            "command_or_case": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "commit": { "$ref": "#/$defs/revision" },
            "reproducible": { "type": "boolean" }
          }
        }
      ]
    },
    "review": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reviewed_at", "review_commit", "result"],
          "properties": {
            "reviewer": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "format": "date-time" },
            "review_commit": { "$ref": "#/$defs/revision" },
            "result": { "enum": ["accepted", "rejected"] }
          }
        }
      ]
    },
    "delivery_commit": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }]
    },
    "acceptance_satisfied": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": { "source_kind": { "const": "fixture" } },
            "required": ["source_kind"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {
          "classification": { "const": "simulado" },
          "acceptance_satisfied": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "classification": { "enum": ["simulado", "estimado", "executado"] } }, "required": ["classification"] },
      "then": { "properties": { "acceptance_satisfied": { "const": false } } }
    },
    {
      "if": { "properties": { "classification": { "enum": ["executado", "validado"] } }, "required": ["classification"] },
      "then": { "properties": { "execution": { "type": "object" } } }
    },
    {
      "if": { "properties": { "classification": { "const": "validado" } }, "required": ["classification"] },
      "then": {
        "properties": {
          "review": { "type": "object" },
          "delivery_commit": { "$ref": "#/$defs/revision" },
          "acceptance_satisfied": { "const": true },
          "provenance": {
            "properties": { "source_kind": { "not": { "const": "fixture" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
